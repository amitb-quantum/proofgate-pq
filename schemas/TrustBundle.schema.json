{
  "$defs": {
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "reference": {
          "$ref": "#/$defs/PolicyRef"
        },
        "suite": {
          "enum": [
            "ed25519-v1",
            "mldsa65-v1",
            "ed25519-mldsa65-v1"
          ],
          "title": "Suite",
          "type": "string"
        },
        "audience": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Audience",
          "type": "string"
        },
        "target": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Target",
          "type": "string"
        },
        "environment": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Environment",
          "type": "string"
        },
        "project": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Project",
          "type": "string"
        },
        "subjects": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Subjects",
          "type": "array"
        },
        "verifier_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Verifier Ids",
          "type": "array"
        },
        "quorum": {
          "maximum": 16,
          "minimum": 1,
          "title": "Quorum",
          "type": "integer"
        },
        "max_qubits": {
          "maximum": 8,
          "minimum": 1,
          "title": "Max Qubits",
          "type": "integer"
        },
        "max_shots": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Shots",
          "type": "integer"
        },
        "human_above_shots": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Human Above Shots",
          "type": "integer"
        },
        "max_intent_ttl": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Intent Ttl",
          "type": "integer"
        },
        "receipt_ttl": {
          "maximum": 600,
          "minimum": 1,
          "title": "Receipt Ttl",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "reference",
        "suite",
        "audience",
        "target",
        "environment",
        "project",
        "subjects",
        "verifier_ids",
        "quorum",
        "max_qubits",
        "max_shots",
        "human_above_shots",
        "max_intent_ttl",
        "receipt_ttl"
      ],
      "title": "Policy",
      "type": "object"
    },
    "PolicyRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "PolicyRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "verifiers": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Verifiers",
      "type": "object"
    },
    "requesters": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Requesters",
      "type": "object"
    },
    "executor_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Executor Id",
      "type": "string"
    },
    "executor_keys": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Executor Keys",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "policy",
    "verifiers",
    "requesters",
    "executor_id",
    "executor_keys"
  ],
  "title": "TrustBundle",
  "type": "object"
}
